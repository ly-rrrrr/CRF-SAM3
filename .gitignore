# Generated training data, checkpoint exports, and temporary runs
Sa2VA-main/category_grounding_mvp/outputs/
Sa2VA-main/category_grounding_mvp/data/**/*.jsonl
Sa2VA-main/category_grounding_mvp/inferera_category_api/results/
Sa2VA-main/crf_sam3_attn/tmp_configs/
**/expression_details/
**/results.json
**/results_from_png.json

# Keep new evaluation artifacts focused on final runs.
/Sa2VA-main/crf_sam3_*/
!/Sa2VA-main/crf_sam3_attn/
